generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Authorization {
  customerId   String   @id
  hsPortalId   String
  accessToken  String
  refreshToken String
  expiresIn    String
  expiresAt    DateTime
}

model ClientCredentialToken {
  id          Int      @id @default(autoincrement())
  accessToken String
  expiresAt   DateTime
}

model Contact {
  id               Int       @id @default(autoincrement())
  hsObjectId       String
  portalId         String
  email            String?
  firstname        String?
  lastname         String?
  lastModifiedDate DateTime?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([hsObjectId, portalId])
  @@index([hsObjectId])
}

// Registry of portals currently known to this app. Populated by the OAuth
// install flow and by APP_LIFECYCLE install events, and pruned on uninstall.
// This backs the portal dropdown in the UI.
model Portal {
  portalId    String   @id
  installedAt DateTime @default(now())
}

model JournalCursor {
  id            Int     @id @default(autoincrement())
  currentOffset String?
  portalId      String  @unique
}

model SnapshotJob {
  id               Int      @id @default(autoincrement())
  snapshotStatusId String   @unique
  status           String   @default("PENDING")
  portalId         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
